# Pretrained backbone models (large) -- .gitkeep keeps the empty folder itself
# tracked so the intended structure shows up on a fresh clone/GitHub browse
models/*
!models/.gitkeep

# Raw and processed dataset images
data/*
!data/.gitkeep

# Calibration outputs
calibrate_crop.jpg
calibrate_preview.jpg

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/

# YOLO inference result images
results/yolo/640C/pcb_inspection/

# YOLO training run artifacts (large — weights, plots, csvs)
results/yolo/640C/pcb_seg*/
results/yolo/CT11_Power/
results/yolo/CT11_Image/

# Heatmap outputs
results/heatmaps/

# Live demo outputs
captures/*
!captures/.gitkeep
results/live/*
!results/live/.gitkeep

# Developer-mode logs and ground-truth review copies (grows continuously
# from real usage -- not build output, but not something to version either)
results/dev_review/
results/inference_log.jsonl
results/verification_log.jsonl

# Misc
.DS_Store
tmp/
yolo26n.pt
